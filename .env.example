# Copy to .env (never committed) or export before `make install-automation`.

# Telegram — remaining/burn + reset-soon alerts
AI_QUOTAS_TELEGRAM_BOT_TOKEN=
AI_QUOTAS_TELEGRAM_CHAT_ID=

# Healthchecks — dead-man's switch for the sample job and the dash KeepAlive.
# Prefer a full ping URL (healthchecks.io or self-hosted):
AI_QUOTAS_HC_SAMPLE_URL=
AI_QUOTAS_HC_DASH_URL=

# Or a ping key + slugs (self-hosted Healthchecks):
# CALMMAGE_HEALTHCHECKS_PING_KEY=
# CALMMAGE_HEALTHCHECKS_BASE_URL=https://healthchecks.example.com
# AI_QUOTAS_SAMPLE_HC_SLUG=ai-quotas-sample
# AI_QUOTAS_DASH_HC_SLUG=ai-quotas-dash
# AI_QUOTAS_HC_INTERVAL=300
# AI_QUOTAS_READ_DOTENV=1   # also read ~/.env for the keys above
