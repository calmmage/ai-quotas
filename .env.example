# Optional OpenRouter API key (also accepted as OPENROUTER_KEY).
# Prefer exporting in the shell; a plain ~/.env KEY=value file is also scanned.
OPENROUTER_API_KEY=

# SQLite database (full path). Wins over AI_QUOTAS_DATA_DIR.
# AI_QUOTAS_DATABASE=~/.local/share/ai-quotas/ai-quotas.sqlite3

# Directory for the database and generated artifacts.
# AI_QUOTAS_DATA_DIR=~/.local/share/ai-quotas

# Legacy JSONL compatibility only (fixtures, migration, rollback).
# AI_QUOTAS_SAMPLES=/path/to/samples.jsonl
# AI_QUOTAS_SPEND=/path/to/spend.jsonl

# Optional directory of extra private adapter modules (drop-in *.py with snapshot(ts)).
# AI_QUOTAS_EXTRA_ADAPTERS=

# Override path to the codexbar binary (Codex live probe).
# CODEXBAR_BIN=
