<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template only — prefer: make install-automation
  (scripts/install-launchagent.sh fills absolute paths).

  Old agent: com.calmmage.quota-snapshot → prototypes/poc/quota-providers/watchdog.py
  New agent: com.calmmage.ai-quotas-sample → `uv run ai-quotas sample` in this repo
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.calmmage.ai-quotas-sample</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>--directory</string>
    <string>/ABS/PATH/TO/ai-quotas</string>
    <string>run</string>
    <string>ai-quotas</string>
    <string>sample</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/ABS/PATH/TO/ai-quotas</string>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/ABS/PATH/TO/data/sample-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/ABS/PATH/TO/data/sample-agent.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/ABS/HOME</string>
    <!-- Optional: set AI_QUOTAS_SAMPLES / AI_QUOTAS_DATA_DIR /
         AI_QUOTAS_EXTRA_ADAPTERS at install time; the installer bakes them in.
         Unset keys are omitted (no invented defaults). -->
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
